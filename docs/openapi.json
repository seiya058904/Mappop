{
  "openapi": "3.1.0",
  "info": {
    "title": "Mappop Markdown API",
    "version": "1.0.0",
    "description": "Create immutable, publicly readable Markdown drafts. No accounts, listing, updates, deletion, LLM calls or MCP. The returned hash-router URL opens the existing editor."
  },
  "servers": [
    { "url": "https://mappop.seiya-api.workers.dev", "description": "Maintained deployment; creation requires its owner's write token" },
    { "url": "http://localhost:8787", "description": "Local development" }
  ],
  "paths": {
    "/api/maps": {
      "post": {
        "operationId": "createMap",
        "summary": "Store a Markdown outline and return its editor URL",
        "description": "Maximum 128 KiB uncompressed UTF-8 JSON and 64 KiB Markdown. Exactly one root heading plus at least one child; headings cannot skip levels. Headings and ordered/unordered lists only; inline text, emphasis, strong, code and links are accepted as label text. No free paragraphs, raw HTML, images, quotes, code blocks or reference definitions. Maximum 500 nodes, 12 levels, 200 title code points and 2000 code points per label. Shared approximate authenticated rate limit 20/minute per Cloudflare location; independent authentication attempts limited by IP. Atomic D1 quotas: 100/day UTC and 10000 drafts total. Each POST creates a new ID; not idempotent.",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["markdown"],
                "properties": {
                  "markdown": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 65536,
                    "description": "The server additionally checks the 65536-byte UTF-8 limit.",
                    "examples": ["# Product launch\n## Research\n- Interview customers\n  - Summarize needs\n## Delivery\n- Ship a prototype\n"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft stored. Anyone with its URL can read it without a token. Links have no automatic expiry.",
            "headers": { "Location": { "description": "Absolute Markdown resource URL", "schema": { "type": "string", "format": "uri" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreatedMap" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "Missing or invalid bearer token",
            "headers": { "WWW-Authenticate": { "schema": { "type": "string", "const": "Bearer" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "413": { "description": "Request or Markdown byte limit exceeded", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "415": { "description": "Use uncompressed application/json", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "422": { "description": "Invalid request object or unsupported/invalid outline", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/maps/{id}.md": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "$ref": "#/components/schemas/MapId" } }],
      "get": {
        "operationId": "getMapMarkdown",
        "summary": "Read the exact immutable draft Markdown",
        "description": "Public access without authentication. Reads start at the D1 primary. Approximate per-IP limit 120/minute per Cloudflare location. Responses are no-store and nosniff; there is no permissive CORS header.",
        "security": [],
        "responses": {
          "200": {
            "description": "Original UTF-8 Markdown",
            "headers": {
              "Cache-Control": { "schema": { "type": "string", "const": "no-store" } },
              "X-Content-Type-Options": { "schema": { "type": "string", "const": "nosniff" } }
            },
            "content": { "text/markdown": { "schema": { "type": "string" } } }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "405": { "$ref": "#/components/responses/MethodNotAllowed" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      },
      "head": {
        "operationId": "headMapMarkdown",
        "summary": "Read draft headers without a response body",
        "security": [],
        "responses": {
          "200": { "description": "Draft exists; same headers as GET without a body" },
          "404": { "description": "Draft not found" },
          "429": { "description": "Read rate limit exceeded" },
          "503": { "description": "API unavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearerAuth": { "type": "http", "scheme": "bearer", "description": "The server-side MAPPOP_API_TOKEN secret; never ship it in a frontend." } },
    "schemas": {
      "MapId": { "type": "string", "pattern": "^[a-f0-9]{48}$", "description": "192 random bits represented as lowercase hexadecimal" },
      "CreatedMap": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "nodeCount", "createdAt", "url", "markdownUrl"],
        "properties": {
          "id": { "$ref": "#/components/schemas/MapId" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "nodeCount": { "type": "integer", "minimum": 2, "maximum": 500 },
          "createdAt": { "type": "string", "format": "date-time" },
          "url": { "type": "string", "format": "uri", "description": "Absolute editor URL, /#/?fileURL=%2Fapi%2Fmaps%2F{id}.md" },
          "markdownUrl": { "type": "string", "format": "uri", "description": "Absolute public Markdown URL" }
        }
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object", "additionalProperties": false, "required": ["code", "message"],
            "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
          }
        }
      }
    },
    "responses": {
      "BadRequest": { "description": "Malformed JSON or UTF-8", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "NotFound": { "description": "Malformed ID, missing draft or unknown API route", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
      "MethodNotAllowed": {
        "description": "Unsupported method; drafts are immutable",
        "headers": { "Allow": { "schema": { "type": "string" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "RateLimited": {
        "description": "Rate limit or daily/total storage quota exceeded. Total cap needs operator action.",
        "headers": { "Retry-After": { "description": "Seconds until rate-limit retry or UTC daily reset; does not clear the total cap", "schema": { "type": "string", "pattern": "^[0-9]+$" } } },
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Unavailable": { "description": "Missing configuration or transient binding/storage failure", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
    }
  }
}
