{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mappop",
  "account_id": "e51d33bf9d0ca73ea5b638e60d62d9f5",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mappop-maps",
      "database_id": "6c235118-4241-4712-9282-41cc28ff54f5",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "31001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "READ_LIMITER",
      "namespace_id": "31002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
